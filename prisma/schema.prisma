// Kalimera — schéma de base
// Chaque contenu éditorial a une ligne "parent" (données non traduisibles :
// ordre, images, techno, dates) et une ligne de traduction par langue
// (titre, slug, textes, SEO). Cela permet des URLs traduites par marché.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  FR
  EN
  ES
}

enum Role {
  ADMIN
  EDITOR
}

enum ProjectKind {
  WEBSITE
  ECOMMERCE
  WEBAPP
  MOBILE
  DESIGN
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

// ---------------------------------------------------------------- utilisateurs

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ---------------------------------------------------------------- services

model Service {
  id        String   @id @default(cuid())
  /// Identifiant stable, non traduit : sert de clé technique et d'ancre.
  key       String   @unique
  /// Nom de l'icône lucide-react affichée sur la carte.
  icon      String   @default("Layers")
  /// Pastilles techno affichées sur la carte (identiques dans toutes les langues).
  stack     String[] @default([])
  position  Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ServiceTranslation[]
  projects     Project[]            @relation("ProjectServices")
  landings     Landing[]            @relation("LandingServices")

  @@index([published, position])
  @@map("services")
}

model ServiceTranslation {
  id             String  @id @default(cuid())
  serviceId      String
  locale         Locale
  slug           String
  title          String
  summary        String
  /// Corps de la page service, en Markdown.
  body           String  @default("")
  seoTitle       String?
  seoDescription String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@unique([locale, slug])
  @@map("service_translations")
}

// ---------------------------------------------------------------- projets

model Project {
  id        String      @id @default(cuid())
  key       String      @unique
  kind      ProjectKind @default(WEBSITE)
  client    String
  /// Année de mise en ligne.
  year      Int
  /// URL publique du site livré, affichée sur la fiche projet.
  liveUrl   String?
  stack     String[]    @default([])
  /// Dégradé de la carte quand aucune image de couverture n'est fournie.
  accent    String      @default("g1")
  featured  Boolean     @default(false)
  position  Int         @default(0)
  published Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  coverImageId String?
  coverImage   Media?  @relation("ProjectCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  gallery      Media[]              @relation("ProjectGallery")
  services     Service[]            @relation("ProjectServices")
  landings     Landing[]            @relation("LandingProjects")
  metrics      ProjectMetric[]
  translations ProjectTranslation[]

  @@index([published, position])
  @@map("projects")
}

model ProjectTranslation {
  id             String  @id @default(cuid())
  projectId      String
  locale         Locale
  slug           String
  title          String
  /// Sur-titre de la carte, ex. « Site vitrine · Hôtellerie ».
  category       String
  summary        String
  challenge      String  @default("")
  solution       String  @default("")
  outcome        String  @default("")
  seoTitle       String?
  seoDescription String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@unique([locale, slug])
  @@map("project_translations")
}

/// Chiffre clé affiché sur la carte projet (badge au survol) et la fiche.
model ProjectMetric {
  id        String @id @default(cuid())
  projectId String
  value     String
  labelFr   String
  labelEn   String
  labelEs   String
  position  Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_metrics")
}

// ---------------------------------------------------------------- journal

model Post {
  id          String    @id @default(cuid())
  key         String    @unique
  category    String    @default("engineering")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  coverImageId String?
  coverImage   Media?  @relation("PostCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  translations PostTranslation[]

  @@index([published, publishedAt])
  @@map("posts")
}

model PostTranslation {
  id             String  @id @default(cuid())
  postId         String
  locale         Locale
  slug           String
  title          String
  excerpt        String
  /// Corps de l'article, en Markdown.
  body           String  @default("")
  /// Libellé de catégorie traduit, ex. « Performance ».
  categoryLabel  String  @default("")
  seoTitle       String?
  seoDescription String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
  @@map("post_translations")
}

// ---------------------------------------------------------------- témoignages

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  published Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avatarId String?
  avatar   Media?  @relation("TestimonialAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  translations TestimonialTranslation[]

  @@map("testimonials")
}

model TestimonialTranslation {
  id            String @id @default(cuid())
  testimonialId String
  locale        Locale
  quote         String
  /// Fonction + société, ex. « Directrice marketing — Thalassa Resorts ».
  role          String

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, locale])
  @@map("testimonial_translations")
}

// ---------------------------------------------------------------- médias

model Media {
  id        String   @id @default(cuid())
  publicId  String   @unique
  url       String
  width     Int
  height    Int
  format    String
  bytes     Int
  /// Texte alternatif par langue, pour l'accessibilité et le SEO.
  altFr     String   @default("")
  altEn     String   @default("")
  altEs     String   @default("")
  createdAt DateTime @default(now())

  projectCovers     Project[]     @relation("ProjectCover")
  projectGalleries  Project[]     @relation("ProjectGallery")
  postCovers        Post[]        @relation("PostCover")
  testimonialAvatar Testimonial[] @relation("TestimonialAvatar")

  @@map("media")
}

// ---------------------------------------------------------------- contact

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  /// Type de projet choisi dans le formulaire.
  subject   String
  budget    String?
  message   String
  locale    Locale        @default(FR)
  status    MessageStatus @default(NEW)
  /// Fiche client créée ou rattachée depuis ce message.
  clientId  String?
  createdAt DateTime      @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------- atterrissage

/// Deux familles de pages d'atterrissage, servies par des routes distinctes.
enum LandingKind {
  /// Page sectorielle : « plateformes pour le courtage en assurance ».
  SECTOR
  /// Page géographique : « développement web à Aix-en-Provence ».
  LOCATION
}

/// Page conçue pour une intention de recherche précise, secteur ou ville.
/// Elle relie une promesse, des services et les réalisations qui la prouvent —
/// c'est ce qui la fait convertir, et ce qui justifie son indexation séparée.
model Landing {
  id         String      @id @default(cuid())
  key        String      @unique
  kind       LandingKind @default(SECTOR)
  icon       String      @default("Layers")
  /// Pastilles affichées sur la carte et sous le titre.
  highlights String[]    @default([])
  position   Int         @default(0)
  published  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  /// Services mis en avant sur la page.
  services Service[] @relation("LandingServices")
  /// Réalisations citées en preuve. Sans preuve, la page convertit mal.
  projects Project[] @relation("LandingProjects")

  translations LandingTranslation[]
  faqs         LandingFaq[]

  @@index([published, kind, position])
  @@map("landings")
}

model LandingTranslation {
  id             String  @id @default(cuid())
  landingId      String
  locale         Locale
  slug           String
  title          String
  /// Chapeau affiché sous le titre.
  lead           String
  /// Corps de la page, en Markdown.
  body           String  @default("")
  seoTitle       String?
  seoDescription String?

  landing Landing @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@unique([landingId, locale])
  @@unique([locale, slug])
  @@map("landing_translations")
}

/// Question fréquente d'une page d'atterrissage. Alimente le bloc visible et
/// les données structurées `FAQPage`, éligibles au résultat enrichi Google.
/// Les trois langues sont sur la même ligne, comme pour `ProjectMetric`.
model LandingFaq {
  id         String @id @default(cuid())
  landingId  String
  position   Int    @default(0)
  questionFr String
  questionEn String @default("")
  questionEs String @default("")
  answerFr   String
  answerEn   String @default("")
  answerEs   String @default("")

  landing Landing @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId, position])
  @@map("landing_faqs")
}

// -------------------------------------------------------------- rendez-vous

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum BookingMode {
  /// Visioconférence : un lien est généré à la réservation.
  VIDEO
  /// Le studio appelle le numéro laissé par le visiteur.
  PHONE
}

/// Appel de découverte réservé depuis le site, à la manière de Calendly.
/// Les créneaux sont calculés dans src/lib/booking ; un créneau n'est pris
/// que par un rendez-vous confirmé, un rendez-vous annulé le libère.
model Booking {
  id          String        @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(CONFIRMED)
  mode        BookingMode   @default(VIDEO)
  name        String
  email       String
  company     String?
  phone       String?
  topic       String?
  message     String?
  locale      Locale        @default(FR)
  meetingUrl  String?
  /// Jeton du lien de gestion envoyé au visiteur : consulter, annuler.
  token       String        @unique
  cancelledAt DateTime?
  /// Fiche client créée ou rattachée à la réservation.
  clientId    String?
  createdAt   DateTime      @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  notes  Note[]

  @@index([status, startsAt])
  @@map("bookings")
}

// ====================================================================== CRM
//
// Gestion commerciale et de production du studio : clients, projets,
// notes d'appel, devis signés en ligne, factures et encaissements.
// Les montants sont en centimes (entiers) : aucun arrondi flottant sur une
// facture.

enum ClientStatus {
  /// Premier contact, pas encore qualifié.
  LEAD
  /// En discussion, devis possible.
  PROSPECT
  /// Au moins un projet signé ou en cours.
  ACTIVE
  /// A travaillé avec nous, plus de projet en cours.
  PAST
  ARCHIVED
}

model Client {
  id              String       @id @default(cuid())
  /// Nom d'usage : « Côté BURO ».
  name            String
  /// Raison sociale, telle qu'elle doit figurer sur les factures.
  legalName       String?
  siren           String?
  vatNumber       String?
  email           String?
  phone           String?
  website         String?
  addressLine1    String?
  addressLine2    String?
  postalCode      String?
  city            String?
  country         String       @default("FR")
  /// D'où vient le client : formulaire, rendez-vous, recommandation…
  source          String?
  status          ClientStatus @default(LEAD)
  /// Mémo libre, affiché en tête de fiche.
  summary         String?
  /// Identité émettrice proposée par défaut sur ses devis et factures.
  defaultIssuerId String?
  /// Faux : seul le nom figure sur les documents (cas des sous-traitances).
  printAddress    Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contacts      ClientContact[]
  deals         Deal[]
  notes         Note[]
  tasks         Task[]
  quotes        Quote[]
  invoices      Invoice[]
  activities    Activity[]
  bookings      Booking[]
  messages      ContactMessage[]
  defaultIssuer Issuer?          @relation("ClientDefaultIssuer", fields: [defaultIssuerId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@map("crm_clients")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  firstName String
  lastName  String?
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("crm_client_contacts")
}

/// Cycle de vie d'un projet, de la piste à la maintenance.
enum DealStage {
  LEAD
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  IN_PROGRESS
  REVIEW
  DELIVERED
  MAINTENANCE
  LOST
}

/// Un projet client : l'affaire commerciale puis sa production.
model Deal {
  id          String    @id @default(cuid())
  clientId    String
  title       String
  stage       DealStage @default(LEAD)
  /// Montant estimé, en centimes HT.
  amountCents Int?
  /// Probabilité de signature, en pourcentage.
  probability Int?
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  deliveredAt DateTime?
  lostReason  String?
  /// Ordre dans la colonne du tableau.
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  tasks      Task[]
  notes      Note[]
  quotes     Quote[]
  invoices   Invoice[]
  activities Activity[]

  @@index([stage, position])
  @@index([clientId])
  @@map("crm_deals")
}

/// Grande étape d'un projet : cadrage, design, développement, recette…
model Milestone {
  id        String    @id @default(cuid())
  dealId    String
  title     String
  dueDate   DateTime?
  doneAt    DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, position])
  @@map("crm_milestones")
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  title       String
  details     String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)
  dueAt       DateTime?
  completedAt DateTime?
  clientId    String?
  dealId      String?
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@map("crm_tasks")
}

enum NoteKind {
  CALL
  MEETING
  EMAIL
  NOTE
}

/// Compte rendu d'appel, de réunion, ou simple note.
model Note {
  id          String   @id @default(cuid())
  clientId    String
  dealId      String?
  bookingId   String?
  kind        NoteKind @default(NOTE)
  title       String?
  /// Corps en Markdown.
  body        String   @default("")
  occurredAt  DateTime @default(now())
  durationMin Int?
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([clientId, occurredAt])
  @@map("crm_notes")
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  CANCELLED
}

model Quote {
  id               String           @id @default(cuid())
  /// Attribué à l'envoi ou à l'acceptation : DEV-2026-11-01. Modifiable.
  number           String?
  issuerId         String?
  currency         String           @default("EUR")
  clientId         String
  dealId           String?
  status           QuoteStatus      @default(DRAFT)
  title            String
  intro            String?
  /// Section « Contexte » du devis.
  context          String?
  /// Phrase « Périmètre », en gras sous le contexte.
  perimeter        String?
  stack            String[]         @default([])
  /// Section « Délai ».
  delay            String?
  /// Section « Hors périmètre de ce devis ».
  outOfScope       String?
  /// Section « Évolutions envisageables ».
  evolutions       String[]         @default([])
  /// Phrase grise sous les modalités de paiement.
  paymentNote      String?
  /// Conditions particulières, affichées avant la signature.
  terms            String?
  issueDate        DateTime?
  validUntil       DateTime?
  validityDays     Int              @default(30)
  depositPercent   Int              @default(50)
  /// Faux : l'accord se fait hors ligne (oral, e-mail), sans page de signature.
  requireSignature Boolean          @default(true)
  acceptedVia      QuoteAcceptance?
  acceptanceNote   String?
  subtotalCents    Int              @default(0)
  vatCents         Int              @default(0)
  totalCents       Int              @default(0)
  /// Jeton du lien public de consultation et de signature.
  token            String           @unique
  /// Coordonnées figées à l'envoi : le document ne change plus ensuite.
  clientSnapshot   Json?
  issuerSnapshot   Json?
  sentAt           DateTime?
  viewedAt         DateTime?
  signedAt         DateTime?
  signerName       String?
  signerEmail      String?
  signerIp         String?
  signerAgent      String?
  /// Signature dessinée, en image PNG encodée.
  signatureImage   String?
  /// Empreinte SHA-256 du contenu signé : prouve qu'il n'a pas changé.
  signedHash       String?
  declinedAt       DateTime?
  declineReason    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  issuer     Issuer?     @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  lines      QuoteLine[]
  invoices   Invoice[]
  activities Activity[]

  /// Une suite de numéros par identité émettrice.
  @@unique([issuerId, number])
  @@index([status, updatedAt])
  @@index([clientId])
  @@map("crm_quotes")
}

enum LineKind {
  ITEM
  SECTION
}

model QuoteLine {
  id              String   @id @default(cuid())
  quoteId         String
  position        Int      @default(0)
  kind            LineKind @default(ITEM)
  title           String
  description     String?
  quantity        Float    @default(1)
  unit            String?
  unitPriceCents  Int      @default(0)
  vatRate         Float    @default(20)
  discountPercent Float    @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@map("crm_quote_lines")
}

enum InvoiceKind {
  /// Facture d'acompte, émise à la signature du devis.
  DEPOSIT
  /// Facture de solde, déduction faite des acomptes.
  BALANCE
  STANDARD
  /// Avoir : annule tout ou partie d'une facture émise.
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id                String        @id @default(cuid())
  /// Numérotation continue par identité, attribuée à l'émission : FAC-2026-11-05.
  number            String?
  issuerId          String?
  currency          String        @default("EUR")
  /// Ligne de contexte facultative : « Prestation hors devis du … ».
  contextLine       String?
  kind              InvoiceKind   @default(STANDARD)
  status            InvoiceStatus @default(DRAFT)
  clientId          String
  dealId            String?
  quoteId           String?
  /// Facture annulée par cet avoir.
  creditedInvoiceId String?
  title             String
  notes             String?
  issueDate         DateTime?
  dueDate           DateTime?
  subtotalCents     Int           @default(0)
  vatCents          Int           @default(0)
  totalCents        Int           @default(0)
  token             String        @unique
  clientSnapshot    Json?
  issuerSnapshot    Json?
  sentAt            DateTime?
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deal       Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  quote      Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  issuer     Issuer?       @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  lines      InvoiceLine[]
  payments   Payment[]
  activities Activity[]

  @@unique([issuerId, number])
  @@index([status, dueDate])
  @@index([clientId])
  @@map("crm_invoices")
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  position        Int      @default(0)
  kind            LineKind @default(ITEM)
  title           String
  description     String?
  quantity        Float    @default(1)
  unit            String?
  unitPriceCents  Int      @default(0)
  vatRate         Float    @default(20)
  discountPercent Float    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("crm_invoice_lines")
}

/// Virement reçu, rapproché d'une facture.
model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  amountCents Int
  receivedAt  DateTime
  method      String   @default("TRANSFER")
  reference   String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("crm_payments")
}

/// Fil d'activité : ce qui s'est passé, et quand.
model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  clientId  String?
  dealId    String?
  quoteId   String?
  invoiceId String?
  createdAt DateTime @default(now())

  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  quote   Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([createdAt])
  @@map("crm_activities")
}

/// Compteurs de numérotation : une ligne par type de document et par année.
model DocumentCounter {
  key   String @id
  value Int    @default(0)

  @@map("crm_document_counters")
}

/// Identité de l'entreprise émettrice, reprise sur devis et factures.
model CompanySettings {
  id                    String   @id @default("default")
  tradeName             String   @default("Kalimera")
  legalName             String?
  legalForm             String?
  siren                 String?
  siret                 String?
  vatNumber             String?
  /// Franchise en base : « TVA non applicable, art. 293 B du CGI ».
  vatExempt             Boolean  @default(false)
  defaultVatRate        Float    @default(20)
  addressLine1          String?
  addressLine2          String?
  postalCode            String?
  city                  String?
  country               String   @default("FR")
  email                 String?
  phone                 String?
  iban                  String?
  bic                   String?
  bankName              String?
  paymentTermsDays      Int      @default(30)
  quoteValidityDays     Int      @default(30)
  defaultDepositPercent Int      @default(30)
  quoteTerms            String?
  invoiceFooter         String?
  updatedAt             DateTime @updatedAt

  @@map("crm_company_settings")
}

/// Règles de la prise de rendez-vous, réglables depuis l'administration.
/// Créneau fermé à la main dans l'agenda (rendez-vous perso, déplacement…).
model BookingBlock {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  label     String?
  createdAt DateTime @default(now())

  @@index([startsAt])
  @@map("crm_booking_blocks")
}

model BookingSettings {
  id              String   @id @default("default")
  durationMinutes Int      @default(30)
  stepMinutes     Int      @default(30)
  bufferMinutes   Int      @default(0)
  minNoticeHours  Int      @default(12)
  horizonDays     Int      @default(21)
  maxPerDay       Int      @default(4)
  /// Plages par jour de semaine : { "1": [["09:30","12:00"], …], … }.
  weekly          Json
  blackoutDates   String[] @default([])
  /// Adresse iCal secrète d'un agenda externe : ses évènements bloquent les créneaux.
  busyCalendarUrl String?
  updatedAt       DateTime @updatedAt

  @@map("crm_booking_settings")
}

/// Comment un devis a été accepté.
enum QuoteAcceptance {
  /// Signé en ligne par le client.
  SIGNATURE
  /// Accord donné à l'oral.
  VERBAL
  EMAIL
  PURCHASE_ORDER
  OTHER
}

/// Identité au nom de laquelle un devis ou une facture est émis : la LLC,
/// une personne en nom propre… Chacune a son en-tête, son pied de page, ses
/// mentions, sa banque et sa propre suite de numéros.
model Issuer {
  id                String   @id @default(cuid())
  /// Nom affiché dans l'administration.
  label             String
  /// Nom imprimé en gras en tête du document.
  name              String
  /// Lignes imprimées sous le nom (adresse, contact, immatriculation…).
  headerLines       String   @default("")
  /// Pied de page imprimé, centré.
  footer            String   @default("")
  email             String?
  phone             String?
  website           String?
  /// Mention de TVA imprimée ; vide : rien n'est imprimé.
  vatMention        String?
  /// Délai de paiement, pénalités, indemnité : imprimés seulement si saisis.
  paymentTerms      String?
  latePenalty       String?
  recoveryFee       String?
  currency          String   @default("EUR")
  bankHolder        String?
  bankName          String?
  iban              String?
  bic               String?
  depositPercent    Int      @default(50)
  quoteValidityDays Int      @default(30)
  invoicePrefix     String   @default("FAC")
  quotePrefix       String   @default("DEV")
  position          Int      @default(0)
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  quotes         Quote[]
  invoices       Invoice[]
  defaultClients Client[]  @relation("ClientDefaultIssuer")

  @@map("crm_issuers")
}
